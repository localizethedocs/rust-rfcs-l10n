#: src/0320-nonzeroing-dynamic-drop.md:449
msgid "// *not* merge point (only one path flows here)\n"
msgstr ""

#: src/0320-nonzeroing-dynamic-drop.md:446
msgid "// This is (2.) referenced above.   {        pDD.y, maybe_set }\n"
msgstr ""

#: src/0320-nonzeroing-dynamic-drop.md:454
