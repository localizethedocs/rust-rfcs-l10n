#: src/3892-complex-numbers.md:1
msgid "Feature Name: `complex_numbers`"
msgstr ""

#: src/3892-complex-numbers.md:2
msgid "Start Date: 2025-12-02"
msgstr ""

#: src/3892-complex-numbers.md:3
msgid ""
"RFC PR: [rust-lang/rfcs#3892](https://github.com/rust-lang/rfcs/pull/3892)"
msgstr ""

#: src/3892-complex-numbers.md:4
